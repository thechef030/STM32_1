  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "type": "cppdbg",
        "request": "launch",
        "name": "STM32_1 과제 3: 인터럽트 LED",
        "cwd": "${workspaceFolder}",
        "preLaunchTask": "STM32: Build Task 3",
        "program": "${workspaceFolder}/build/Debug/ece2_474.elf",
        "MIMode": "gdb",
        "targetArchitecture": "arm",
        "miDebuggerPath": "C:/Users/tjgus/stm32_lab/.tools/bin/arm-none-eabi-gdb.exe",
        "debugServerPath": "C:/Users/tjgus/stm32_lab/.tools/bundles/stlink-gdbserver/7.14.0+st.2/bin/ST-LINK_gdbserver.exe",
        "debugServerArgs": "-p 3333 -z 3334 -d -k -cp \"C:/Users/tjgus/stm32_lab/.tools/bundles/programmer/2.23.0/bin\"",
        "serverStarted": "Waiting for debugger connection",
        "serverLaunchTimeout": 30000,
        "filterStdout": true,
        "filterStderr": true,
        "externalConsole": false,
        "stopAtEntry": false,
        "customLaunchSetupCommands": [
          {
            "text": "-file-exec-and-symbols \"C:/Users/tjgus/stm32_1/build/Debug/ece2_474.elf\"",
            "description": "Load firmware executable and debug symbols"
          },
          {
            "text": "-target-select remote localhost:3333",
            "description": "Connect to ST-LINK"
          },
          {
            "text": "-interpreter-exec console \"monitor reset\"",
            "description": "Reset target"
          },
          {
            "text": "-target-download",
            "description": "Download firmware"
          },
          {
            "text": "-interpreter-exec console \"monitor reset\"",
            "description": "Reset after download"
          },
          {
            "text": "-break-insert -t main",
            "description": "Stop at main"
          }
        ],
        "launchCompleteCommand": "exec-continue"
